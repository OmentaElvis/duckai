{
  "name": "duckai",
  "version": "1.0.0",
  "private": true,
  "author": "OmentaElvis <omentaelvis@gmail.com>",
  "homepage": "https://github.com/OmentaElvis/duckai",
  "type": "module",
  "scripts": {
    "build:inject": "bun scripts/build-inject.ts",
    "build:inject:min": "bun scripts/build-inject.ts --minify",
    "dev": "bun run build:inject && bun src/main.ts",
    "test": "bun test",
    "pretypecheck": "bun run build:inject",
    "typecheck": "tsc --noEmit",
    "build": "bun run build:inject:min && bun build --compile --minify --target=bun-linux-x64 src/main.ts src/worker.ts --outfile dist/duckai",
    "build:deb": "bun scripts/build-deb.ts",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "dependencies": {
    "webview-bun": "^2.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.2.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.0"
  }
}
